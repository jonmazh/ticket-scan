    "postcss": "8.5.33",
    "sharp": "0.35.5",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "typescript-eslint": "8.72.2",
    "vite": "6.4.6",
    "vite-plugin-pwa": "1.0.0",
    "vitest": "3.2.7",
