  },
  "dependencies": {
    "date-fns": "4.1.0",
    "dexie": "4.0.11",
    "dexie-react-hooks": "1.1.7",
    "fflate": "0.8.3",
    "lucide-react": "0.511.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "tesseract.js": "6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/spa": "1.0.0",
    "@types/node": "22.15.29",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.5.0",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.5",
